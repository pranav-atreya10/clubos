# ---- Database (Postgres) ----
# Leave empty locally to use the built-in database (saved in ./.data).
# For the live site, paste your Supabase connection string:
#   Supabase → your project → Connect → "Transaction pooler" (port 6543), with your password in it.
# This is a secret: in Vercel, mark it "Sensitive".
DATABASE_URL=

# ---- Feedback inbox ----
# Your ClubOS login email(s), comma-separated. Only these accounts see /app/feedback.
OWNER_EMAILS=
