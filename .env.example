# ---- Database (Postgres) ----
# Leave empty to use the built-in local database (saved in ./.data) with the sample club.
# For real use, paste your Supabase connection string:
#   Supabase → your project → Connect → "Transaction pooler" (port 6543), and put your password in it.
DATABASE_URL=

# ---- Logins (Clerk) ----
# Leave empty for demo mode (Officer / Advisor / Member switch, no sign-in).
# Add keys from https://dashboard.clerk.com to turn on real sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
