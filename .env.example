# ---- Database (Postgres) ----
# Leave empty locally to use the built-in database (saved in ./.data).
# For the live site, paste your Supabase connection string:
#   Supabase → your project → Connect → "Transaction pooler" (port 6543), with your password in it.
# This is a secret: in Vercel, mark it "Sensitive".
DATABASE_URL=

# ---- Feedback inbox ----
# Your ClubOS login email(s), comma-separated. Only these accounts see /app/feedback.
OWNER_EMAILS=

# ---- "Forgot password" emails (optional) ----
# Gmail: turn on 2-Step Verification for the account, then make an App Password
# (Google Account → Security → App passwords) and paste it below. Mark SMTP_PASS "Sensitive".
# Without these, officers can still make reset links for members in Members.
SMTP_USER=atreyapranav@gmail.com
SMTP_PASS=
# SMTP_FROM="ClubOS <atreyapranav@gmail.com>"
